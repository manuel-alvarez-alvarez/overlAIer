# overlAIer configuration
# CLI arguments always take precedence over values here.
# Uncomment and edit the settings you want to change.

# [device]
# video_in  = "/dev/video0"
# video_out = "/dev/dri/card0:HDMI-A-2"
# audio_in  = "hw:0,0"
# audio_out = "hw:1,0"

# [format]
# fmt_in  = "NV24"
# fmt_out = "BG24"
# res_in  = "1920x1080"
# res_out = "2560x1440"
# fps_in  = 60
# fps_out = 120

# [general]
# log_level  = "info"
# async_flip = false

# Processor plugins to load. Each [[processor]] entry specifies
# a shared library path. The program will fail if any cannot be loaded.
#
# [[processor]]
# path = "/path/to/fps_counter.so"
#
# [[processor]]
# path = "/path/to/another_plugin.so"

# USB HID device proxy. Devices are forwarded from host USB to the
# target PC via USB OTG. HID reports pass through the processor chain.
# Use 'overlAIer query' to list connected HID devices and their VID:PID.
#
# [usb]
# udc = "fe800000.usb"    # UDC controller (auto-detect if omitted)
#
# [[usb.device]]
# vid_pid = "045e:028e"   # Xbox controller
#
# [[usb.device]]
# vid_pid = "046d:c52b"   # Logitech receiver
