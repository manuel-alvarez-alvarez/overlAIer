[Unit]
Description=OverlAIer - Real-time HDMI overlay pipeline (system)
Documentation=https://github.com/manuel-alvarez-alvarez/overlAIer
After=local-fs.target

[Service]
Type=simple
User=USER
ExecStart=/home/USER/.overlAIer/bin/overlAIer --config /home/USER/.overlAIer/overlAIer.toml
EnvironmentFile=-/home/USER/.overlAIer/overlaier.env
Restart=on-failure
RestartSec=5
# Required for USB proxy (ConfigFS, hidraw, evdev grab)
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_RAWIO
SupplementaryGroups=input

[Install]
WantedBy=multi-user.target
